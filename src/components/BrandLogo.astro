---
interface Props {
  /** Aplica el área de protección recomendada por el manual (altura equivalente a la pastilla "24hs"). */
  safeSpace?: boolean;
  /** Altura visual del logotipo. El ancho mínimo siempre respeta 160px según el manual. */
  size?: "sm" | "md" | "lg";
  /** Variante para fondos oscuros: invierte el grafito del isotipo y del logotipo. */
  inverse?: boolean;
  class?: string;
}

const {
  safeSpace = false,
  size = "md",
  inverse = false,
  class: className = "",
} = Astro.props;

const keyFill = inverse ? "#F9FAFB" : "#18181B";

const sizeClasses = {
  sm: "text-base",
  md: "text-xl sm:text-2xl",
  lg: "text-2xl sm:text-3xl",
}[size];
---

<a
  href="/"
  aria-label="Cerrajería Urgencias 24hs - Inicio"
  class:list={[
    "inline-flex items-center gap-[0.45em] min-w-[160px] select-none no-underline shrink-0",
    safeSpace && "p-[0.85em]",
    sizeClasses,
    className,
  ]}
>
  <!-- Isotipo vectorial (reloj en movimiento #DC2626 + bocallave #18181B) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 352 252"
    fill="none"
    aria-hidden="true"
    class="h-[2.35em] w-auto shrink-0"
  >
    <g fill="#DC2626">
      <path d="M 98 2 H 216 V 24 H 210 A 102 102 0 0 0 210 228 H 198 L 191 250 H 96 A 11 11 0 0 1 96 228 H 140 A 124 124 0 0 1 140 24 H 98 A 11 11 0 0 1 98 2 Z" />
      <rect x="28" y="60" width="29" height="19" rx="9.5" />
      <rect x="70" y="60" width="46" height="19" rx="9.5" />
      <rect x="0" y="115" width="116" height="21" rx="10.5" />
      <rect x="29" y="173" width="31" height="20" rx="10" />
      <rect x="73" y="173" width="43" height="20" rx="10" />
      <rect x="203" y="20" width="13" height="24" rx="5" />
      <rect x="104" y="119" width="25" height="13" rx="5" />
      <path d="M 137 195 L 154 178 A 6 6 0 0 1 163 187 L 146 204 A 6 6 0 0 1 137 195 Z" />
      <circle cx="210" cy="126" r="14" />
      <line x1="210" y1="126" x2="210" y2="66" stroke="#DC2626" stroke-width="13" stroke-linecap="round" />
      <line x1="210" y1="126" x2="167" y2="169" stroke="#DC2626" stroke-width="14" stroke-linecap="round" />
    </g>
    <g fill={keyFill}>
      <path d="M 229 8.5 A 84 84 0 0 1 349 84 C 349 102 343 119 332 132 L 350 250 H 207 L 214 228 H 323 L 308 128 C 319 116 326 101 326 84 A 61 61 0 0 0 229 35.5 Z" />
      <circle cx="265" cy="84" r="34" />
      <path d="M 250 110 H 280 L 295 203 H 235 Z" />
    </g>
  </svg>

  <!-- Logotipo tipográfico con Plus Jakarta Sans -->
  <span
    class:list={[
      "flex flex-col leading-none font-display",
      inverse ? "text-blanco-hueso" : "text-carbon-grafito",
    ]}
  >
    <span class="text-[1.15em] font-extrabold tracking-tight leading-[0.95]">
      Cerrajería BM
    </span>
    <span class="mt-[0.14em] flex items-center gap-[0.28em]">
      <span class="text-[0.88em] font-bold tracking-tight leading-none">
        Urgencias
      </span>
      <span
        class="inline-flex items-center justify-center rounded-[0.22em] bg-rojo-emergencia px-[0.36em] py-[0.16em] text-[0.55em] font-extrabold leading-none text-white"
      >
        24hs
      </span>
    </span>
  </span>
</a>
