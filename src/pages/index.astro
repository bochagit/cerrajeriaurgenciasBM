---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import HeroIllustration from "../components/HeroIllustration.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import CoverageZones from "../components/CoverageZones.astro";
import { SITE } from "../data/site";
import { SERVICIOS } from "../data/servicios";
import { BENEFICIOS, PASOS, FAQS } from "../data/content";
---

<BaseLayout>
  <!-- Header base con marca y estado de disponibilidad 24hs -->
  <header class="border-b border-carbon-grafito/15 bg-blanco-hueso">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
      <BrandLogo size="sm" />

      <div class="flex items-center gap-3">
        <span class="hidden items-center gap-2 text-sm font-medium text-carbon-grafito sm:inline-flex">
          <span class="h-2.5 w-2.5 rounded-full bg-rojo-emergencia" aria-hidden="true"></span>
          {SITE.availabilityLabel}
        </span>

        <a href={SITE.phoneHref} class="btn-llamar px-4 py-2.5 text-sm">
          Llamar {SITE.phoneDisplay}
        </a>
      </div>
    </div>
  </header>

  <!-- Esqueleto inicial (Hero + botones del Manual de Marca) -->
  <main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <section class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] lg:gap-14">
      <div>
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-carbon-grafito/20 px-3 py-1 text-xs font-medium text-carbon-grafito">
          <span class="h-2 w-2 rounded-full bg-rojo-emergencia" aria-hidden="true"></span>
          <span>Atención inmediata</span>
        </div>

        <h1 class="font-display text-4xl font-extrabold tracking-tight text-carbon-grafito sm:text-5xl">
          Cerrajería BM, urgencias las 24 horas en {SITE.coverageLabel}
        </h1>

        <p class="mt-4 text-base leading-relaxed text-carbon-grafito/80 sm:text-lg">
          Contactate con nosotros: un profesional va a estar brindándote ayuda segura y rápida para cualquier tipo de urgencia.
        </p>

        <!-- Jerarquía de botones según Sección 04 del Manual de Marca -->
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={SITE.phoneHref} class="btn-llamar text-base">
            Llamar Ahora ({SITE.phoneDisplay})
          </a>
          <a
            href={SITE.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp text-base"
          >
            WhatsApp ({SITE.whatsappDisplay})
          </a>
        </div>
      </div>

      <!-- Único apoyo visual: ilustración vectorial propia, sin licencias externas.
           Se oculta en móvil para no desplazar los botones de contacto below-the-fold. -->
      <div class="hidden lg:block">
        <div
          class="aspect-[4/5] w-full overflow-hidden rounded-2xl border border-carbon-grafito/10 bg-blanco-hueso"
        >
          <HeroIllustration />
        </div>
      </div>
    </section>

    <!-- Indicador de scroll hacia la siguiente sección -->
    <div class="mt-14 flex justify-center sm:justify-start">
      <a
        href="#servicios"
        class="inline-flex items-center gap-2 text-md font-medium text-carbon-grafito/60 transition-colors hover:text-carbon-grafito"
      >
        Deslizá para ver los servicios
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="animate-nudge h-4 w-4"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </a>
    </div>
  </main>

  <!-- Servicios: banda en Carbón Grafito para marcar el cambio de sección -->
  <section
    id="servicios"
    class="scroll-mt-8 bg-carbon-grafito py-16 text-blanco-hueso sm:py-24"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p
          class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-blanco-hueso/60 uppercase"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-rojo-emergencia" aria-hidden="true"></span>
          Servicios urgentes
        </p>
        <h2
          class="mt-4 font-display text-3xl font-extrabold tracking-tight text-blanco-hueso sm:text-4xl"
        >
          Soluciones para cada situación
        </h2>
        <p class="mt-4 text-base leading-relaxed text-blanco-hueso/65">
          Los servicios que ofrecemos, respaldados por nuestro conocimiento y experiencia.
        </p>
      </div>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          SERVICIOS.map((servicio, index) => (
            <li
              class="group animate-fade-up rounded-2xl bg-blanco-hueso p-6 text-carbon-grafito shadow-lg shadow-black/10 ring-1 ring-white/10"
              style={`--stagger: ${index}`}
            >
              <div class="flex items-start justify-between gap-4">
                <span
                  class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-carbon-grafito text-blanco-hueso transition-[transform,background-color] duration-300 ease-out group-hover:-rotate-6 group-hover:scale-125 group-hover:bg-rojo-emergencia motion-reduce:transition-none"
                >
                  <ServiceIcon
                    name={servicio.icon}
                    class="h-6 w-6 transition-transform duration-300 ease-out group-hover:scale-110 motion-reduce:transition-none"
                  />
                </span>
                <span
                  class="font-display text-sm font-bold text-carbon-grafito/30 transition-opacity duration-300 motion-reduce:transition-none"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <div
                class="transition-opacity duration-300 motion-reduce:transition-none"
              >
                <h3 class="mt-5 font-display text-lg font-bold text-carbon-grafito">
                  {servicio.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-carbon-grafito/70">
                  {servicio.description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <!-- Contacto + cobertura -->
  <section id="contacto" class="scroll-mt-8 border-t border-carbon-grafito/10 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p
            class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-carbon-grafito/60 uppercase"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-rojo-emergencia" aria-hidden="true"></span>
            Atención 24hs
          </p>
          <h2
            class="mt-4 font-display text-3xl font-extrabold tracking-tight text-carbon-grafito sm:text-4xl"
          >
            Llamanos ahora, salimos ya
          </h2>
          <p class="mt-4 text-base leading-relaxed text-carbon-grafito/70">
            Contanos tu situación y te atendemos de inmediato. Sin formularios ni esperas.
          </p>

          <a
            href={SITE.phoneHref}
            class="mt-8 block font-display text-3xl font-extrabold tracking-tight text-carbon-grafito sm:text-4xl"
          >
            {SITE.phoneDisplay}
          </a>
          <p class="mt-2 text-sm text-carbon-grafito/60">
            Llegada estimada: {SITE.responseTime}
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={SITE.phoneHref} class="btn-llamar text-base">
              Llamar Ahora
            </a>
            <a
              href={SITE.whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp text-base"
            >
              WhatsApp
            </a>
          </div>

          <div class="mt-8">
            <h3
              class="font-display text-xs font-bold tracking-[0.14em] text-carbon-grafito/60 uppercase"
            >
              Zonas de cobertura
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {
                SITE.coverageZones.map((zona) => (
                  <li class="rounded-full border border-carbon-grafito/20 px-3 py-1 text-sm text-carbon-grafito/80">
                    {zona}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <CoverageZones />
      </div>
    </div>
  </section>

  <!-- Confianza -->
  <section
    id="confianza"
    class="scroll-mt-8 border-t border-carbon-grafito/10 bg-carbon-grafito/5 py-16 sm:py-20"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <p
        class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-carbon-grafito/60 uppercase"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-rojo-emergencia" aria-hidden="true"></span>
        Por qué elegirnos
      </p>
      <h2
        class="mt-4 max-w-2xl font-display text-3xl font-extrabold tracking-tight text-carbon-grafito sm:text-4xl"
      >
        Tranquilidad cuando más la necesitás
      </h2>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          BENEFICIOS.map((beneficio, index) => (
            <li
              class="animate-fade-up rounded-2xl border border-carbon-grafito/10 bg-blanco-hueso p-5"
              style={`--stagger: ${index}`}
            >
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-carbon-grafito text-blanco-hueso">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="h-4 w-4"
                >
                  <path d="m5 12 4 4L19 6" />
                </svg>
              </span>
              <h3 class="mt-4 font-display text-base font-bold text-carbon-grafito">
                {beneficio.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-carbon-grafito/70">
                {beneficio.description}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section
    id="como-trabajamos"
    class="scroll-mt-8 bg-carbon-grafito py-16 text-blanco-hueso sm:py-24"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <p
        class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-blanco-hueso/60 uppercase"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-rojo-emergencia" aria-hidden="true"></span>
        Cómo trabajamos
      </p>
      <h2
        class="mt-4 max-w-2xl font-display text-3xl font-extrabold tracking-tight text-blanco-hueso sm:text-4xl"
      >
        Tres pasos y listo
      </h2>

      <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
        {
          PASOS.map((paso, index) => (
            <li class="animate-fade-up" style={`--stagger: ${index}`}>
              <span class="font-display text-5xl font-extrabold text-blanco-hueso/25">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-blanco-hueso">
                {paso.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-blanco-hueso/65">
                {paso.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section id="faq" class="scroll-mt-8 py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <p
        class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-carbon-grafito/60 uppercase"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-rojo-emergencia" aria-hidden="true"></span>
        Preguntas frecuentes
      </p>
      <h2
        class="mt-4 font-display text-3xl font-extrabold tracking-tight text-carbon-grafito sm:text-4xl"
      >
        Lo que seguramente te preguntás
      </h2>

      <div class="mt-10 border-y border-carbon-grafito/15">
        {
          FAQS.map((faq) => (
            <details class="border-b border-carbon-grafito/15 last:border-b-0">
              <summary
                class="flex cursor-pointer items-center justify-between gap-6 py-5 font-display text-base font-semibold text-carbon-grafito sm:text-lg"
              >
                {faq.question}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                  class="faq-icon h-5 w-5 shrink-0 text-carbon-grafito/50"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="max-w-2xl pb-5 text-sm leading-relaxed text-carbon-grafito/70">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Footer: marca, contacto y cobertura -->
  <footer class="bg-carbon-grafito py-12 text-blanco-hueso">
    <div
      class="mx-auto flex max-w-5xl flex-col gap-10 px-4 sm:px-6 lg:flex-row lg:items-start lg:justify-between lg:gap-16"
    >
      <BrandLogo inverse size="lg" />

      <div class="grid gap-8 sm:grid-cols-2 sm:gap-12">
        <div>
          <h3
            class="font-display text-xs font-bold tracking-[0.14em] text-blanco-hueso/50 uppercase"
          >
            Contacto
          </h3>
          <ul class="mt-4 space-y-2 text-sm">
            <li>
              <a
                href={SITE.phoneHref}
                class="text-blanco-hueso/80 transition-colors hover:text-blanco-hueso"
              >
                {SITE.phoneDisplay}
              </a>
            </li>
            <li>
              <a
                href={SITE.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blanco-hueso/80 transition-colors hover:text-blanco-hueso"
              >
                WhatsApp {SITE.whatsappDisplay}
              </a>
            </li>
            <li class="flex items-center gap-2 pt-1 text-xs text-blanco-hueso/50">
              <span class="h-1.5 w-1.5 rounded-full bg-rojo-emergencia" aria-hidden="true"></span>
              {SITE.availabilityLabel}
            </li>
          </ul>
        </div>

        <div>
          <h3
            class="font-display text-xs font-bold tracking-[0.14em] text-blanco-hueso/50 uppercase"
          >
            Cobertura
          </h3>
          <p class="mt-4 text-sm leading-relaxed text-blanco-hueso/70">
            {SITE.coverageLabel}
          </p>
          <p class="mt-2 text-xs text-blanco-hueso/45">
            Cobertura orientativa: confirmá tu localidad al contactarnos.
          </p>
        </div>
      </div>
    </div>
  </footer>

  <!-- Barra fija de contacto en móvil -->
  <div
    class="fixed inset-x-0 bottom-0 z-50 border-t border-carbon-grafito/10 bg-blanco-hueso/95 px-4 py-3 backdrop-blur lg:hidden"
  >
    <div class="mx-auto flex max-w-5xl gap-3">
      <a href={SITE.phoneHref} class="btn-llamar flex-1 py-3 text-sm">
        Llamar
      </a>
      <a
        href={SITE.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp flex-1 py-3 text-sm"
      >
        WhatsApp
      </a>
    </div>
  </div>
</BaseLayout>
